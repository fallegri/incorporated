# Incorporated — Variables de Entorno
# Copiar a .env.local y completar

# --- Base de Datos (Neon) ---
DATABASE_URL="postgresql://user:password@host.neon.tech/incorporated?sslmode=require"

# --- Autenticación (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-un-secret-aleatorio-aqui"

# --- IA: Modo de operación ---
# Opciones: "gemini" | "ollama" | "none"
AI_PROVIDER="gemini"

# --- IA: Google Gemini (si AI_PROVIDER=gemini) ---
GOOGLE_GENERATIVE_AI_API_KEY="tu-api-key-de-gemini-aqui"

# --- IA: Ollama Local (si AI_PROVIDER=ollama) ---
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.1"

# --- Storage (Vercel Blob) ---
BLOB_READ_WRITE_TOKEN="tu-token-de-vercel-blob"

# --- App Config ---
APP_MODE="enterprise"
APP_URL="http://localhost:3000"
