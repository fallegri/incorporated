generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

enum AppMode {
  enterprise
  individual
}

enum AIProvider {
  gemini
  nvidia
  ollama
  none
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DIRECTOR
  JEFE_AREA
  JEFE_PROYECTO
  COLABORADOR
  INDIVIDUAL
}

model Organization {
  id         String    @id @default(cuid())
  name       String
  mode       AppMode   @default(enterprise)
  aiProvider AIProvider @default(none) @map("ai_provider")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  users      User[]
  areas      Area[]
  documents  Document[]
  cargos     Cargo[]

  @@map("organizations")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  passwordHash   String?   @map("password_hash")
  role           Role      @default(COLABORADOR)
  isActive       Boolean   @default(true) @map("is_active")
  twoFactorSecret String?  @map("two_factor_secret")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organizationId String?   @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])

  cargoId        String?   @map("cargo_id")
  cargo          Cargo?    @relation(fields: [cargoId], references: [id])

  uploadedDocs   Document[] @relation("UploadedBy")
  objetivos      Objetivo[]
  checklists     OnboardingChecklist[]
  chatSessions   ChatSession[]

  @@map("users")
}

// ============================================================
// ORGANIZATIONAL STRUCTURE
// ============================================================

model Area {
  id             String   @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime @default(now()) @map("created_at")

  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  parentId       String?  @map("parent_id")
  parent         Area?    @relation("AreaHierarchy", fields: [parentId], references: [id])
  children       Area[]   @relation("AreaHierarchy")

  directorId     String?  @map("director_id")

  cargos         Cargo[]

  @@map("areas")
}

model Cargo {
  id             String   @id @default(cuid())
  name           String
  description    String?
  competencias   String[] @default([])
  reportsTo      String?  @map("reports_to")
  createdAt      DateTime @default(now()) @map("created_at")

  organizationId String   @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  areaId         String?  @map("area_id")
  area           Area?    @relation(fields: [areaId], references: [id])

  users          User[]
  objetivos      Objetivo[]
  checklists     OnboardingChecklist[]

  @@map("cargos")
}

// ============================================================
// OBJECTIVES, OKRs, KPIs
// ============================================================

enum ObjetivoTipo {
  ESTRATEGICO
  OPERATIVO
}

enum ObjetivoEstado {
  BORRADOR
  PENDIENTE_APROBACION
  APROBADO
  EN_PROGRESO
  COMPLETADO
}

model Objetivo {
  id               String         @id @default(cuid())
  titulo           String
  descripcion      String
  tipo             ObjetivoTipo   @default(ESTRATEGICO)
  alineamientoPei  String?        @map("alineamiento_pei")
  estado           ObjetivoEstado @default(BORRADOR)
  periodo          String?        // e.g. "2024", "2023"
  gestion          String?        // Gestión/año al que pertenece
  generadoPorIA    Boolean        @default(false) @map("generado_por_ia")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  cargoId          String         @map("cargo_id")
  cargo            Cargo          @relation(fields: [cargoId], references: [id], onDelete: Cascade)

  userId           String?        @map("user_id")
  user             User?          @relation(fields: [userId], references: [id])

  kpis             KPI[]
  actividades      Actividad[]
  okrs             OKR[]

  @@map("objetivos")
}

model KPI {
  id          String   @id @default(cuid())
  nombre      String
  metrica     String
  meta        String
  valorActual String?  @map("valor_actual")
  frecuencia  String   @default("trimestral")
  createdAt   DateTime @default(now()) @map("created_at")

  objetivoId  String   @map("objetivo_id")
  objetivo    Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)

  @@map("kpis")
}

model OKR {
  id          String   @id @default(cuid())
  objective   String
  keyResults  Json     @default("[]") @map("key_results")
  progress    Float    @default(0)
  periodo     String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  objetivoId  String   @map("objetivo_id")
  objetivo    Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)

  @@map("okrs")
}

model Actividad {
  id          String   @id @default(cuid())
  descripcion String
  plazoDias   String   @map("plazo_dias")
  prioridad   String   @default("media")
  estado      String   @default("pendiente") // pendiente, en_curso, terminado
  completada  Boolean  @default(false)
  completadaAt DateTime? @map("completada_at")
  createdAt   DateTime @default(now()) @map("created_at")

  objetivoId  String   @map("objetivo_id")
  objetivo    Objetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)

  @@map("actividades")
}

// ============================================================
// DOCUMENTS & RAG
// ============================================================

enum DocumentType {
  PEI
  FODA
  MOF
  POI
  OTRO
}

enum DocumentFormat {
  PDF
  DOCX
  DOC
  XLSX
  XLS
  TXT
  MD
  TEXT
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  CHUNKING
  EMBEDDING
  READY
  ERROR
}

model Document {
  id             String         @id @default(cuid())
  name           String
  type           DocumentType   @default(OTRO)
  format         DocumentFormat @default(PDF)
  url            String?
  rawText        String?        @map("raw_text") @db.Text
  status         DocumentStatus @default(UPLOADED)
  chunksCount    Int            @default(0) @map("chunks_count")
  errorMessage   String?        @map("error_message")
  createdAt      DateTime       @default(now()) @map("created_at")

  organizationId String         @map("organization_id")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  uploadedById   String         @map("uploaded_by_id")
  uploadedBy     User           @relation("UploadedBy", fields: [uploadedById], references: [id])

  chunks         DocumentChunk[]

  @@map("documents")
}

model DocumentChunk {
  id          String                    @id @default(cuid())
  content     String
  embedding   String?  @db.Text  // Will store vector as JSON string until pgvector extension is enabled
  chunkIndex  Int                       @map("chunk_index")
  metadata    Json?
  createdAt   DateTime                  @default(now()) @map("created_at")

  documentId  String                    @map("document_id")
  document    Document                  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("document_chunks")
}

// ============================================================
// ONBOARDING
// ============================================================

model OnboardingChecklist {
  id          String   @id @default(cuid())
  items       Json     @default("[]")
  progress    Float    @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  cargoId     String   @map("cargo_id")
  cargo       Cargo    @relation(fields: [cargoId], references: [id])

  @@map("onboarding_checklists")
}

// ============================================================
// CHAT / AI SESSIONS
// ============================================================

model ChatSession {
  id          String        @id @default(cuid())
  title       String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  userId      String        @map("user_id")
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages    ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id          String   @id @default(cuid())
  role        String
  content     String
  sources     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  sessionId   String   @map("session_id")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
